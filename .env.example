# DeepSeek AI API 配置
# 注册地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embed

# MySQL 数据库配置
DB_URL=jdbc:mysql://localhost:3306/smart_code_note?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=your-password

# Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 密钥（生产环境请使用 32+ 位随机字符串）
JWT_SECRET=your-jwt-secret-change-me
