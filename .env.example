# ============================================
# Smart Code Note — 环境变量模板
# 复制为 .env 并填入真实值
# ============================================

# DeepSeek AI API Key (必填)
# 注册地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-chat

# MySQL (Docker Compose 默认值即可)
DB_URL=jdbc:mysql://localhost:3306/smart_code_note?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=root

# Redis (Docker Compose 默认值即可)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 密钥（生产环境请使用 32+ 位随机字符串）
JWT_SECRET=your-jwt-secret-change-me

# MinIO 对象存储 (Docker Compose 默认值即可)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=smart-code-note
